{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  // pnpm workspaces are auto-discovered. These overrides add external
  // runtime entry points and widen project globs where Knip's defaults do
  // not cover the repository's actual execution model.
  "workspaces": {
    ".": {
      // Root scripts run from package.json; Factory loads hooks from settings.json.
      "entry": ["scripts/*.{js,mjs,cjs,ts}", ".factory/hooks/**/*.{js,mjs,cjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,cjs,ts}", ".factory/hooks/**/*.{js,mjs,cjs,ts}"]
    },

    "apps/cli": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      // Inlined honest-mod fixtures are written to disk as runtime source
      // and loaded by the CLI's jiti loader; the workspace devDep is the
      // resolution target, not a static import surface.
      "ignoreDependencies": ["baka-sdk"]
    },

    "apps/mcp": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },

    "apps/landing": {
      "project": ["src/**/*.{ts,tsx,js,jsx}"]
    },

    "apps/registry": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
      // Validator-built seed harness: spawned directly via `tsx` by
      // user-testing flows (drives the registry through curl against a
      // real HTTP port). It also exports `bootSeedPublishingServer`
      // + `seedCommunityScreenedFixture` which the in-tree test
      // `seed-community-fixture.test.ts` imports, so it does not
      // need an ignore entry — knip discovers both callsites.
      "ignore": ["test/seed-server.ts"]
    },

    "modules/baka-base": {
      // ModuleRegistry loads action and validator exports by manifest ID through jiti.
      "entry": ["*/action.ts", "**/validators/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },

    "modules/sdd": {
      // ModuleRegistry loads action and validator exports by manifest ID through jiti.
      "entry": ["*/action.ts", "**/validators/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },

    "modules/ts-style": {
      // ModuleRegistry loads action and validator exports by manifest ID through jiti.
      "entry": ["*/action.ts", "**/validators/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },

    "packages/agent-engine": {
      "project": ["src/**/*.{ts,tsx}"]
    },

    "packages/ast-tooling": {
      "project": ["src/**/*.{ts,tsx}"]
    },

    "workflows/feature-planning": {
      "project": ["src/**/*.{ts,tsx}"]
    },

    "workflows/module-management": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },

  // Keep every Knip issue category blocking. New categories must be reviewed
  // rather than silently joining an implicit baseline.
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "classMembers": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error",
    "catalog": "error"
  }
}
