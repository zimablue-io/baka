# Testing
coverage

# Browser-automation scratch output. The Playwright MCP server writes
# page snapshots and console logs to .playwright-mcp/ at the repo root
# on every navigate / snapshot / console call. Throwaway — never commit.
.playwright-mcp/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Baka runtime state
.baka/
docs/superpowers/

# Editor / scratch
.tmp/
*.swp

# Local live verification (throwaway project + fake HOME). Never commit.
LIVE/

# Pack output (created by `pnpm pack` / CI smoke)
*.tgz
dist-tarballs/

# Packs: per-recipe `out/` residue dropped by reasoning-recipe runs.
# Audit-packs.md (DEAD residue): dogfood runs copy templates into
# packs/<pack>/<recipe>/out/. Explicit, scoped suppression — do NOT rely
# on the catch-all `out/` rule above (it is too broad and historically
# incidental).
packs/**/out/

# Releases
**/release/
