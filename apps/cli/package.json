{
	"name": "@baka/cli",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"bin": {
		"baka": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"dev": "tsx src/index.ts",
		"baka": "tsx src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:real-llm": "RUN_REAL_LLM=1 vitest run test/baka-pack-create.test.ts"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"commander": "^15.0.0",
		"jiti": "^2.7.0"
	},
	"devDependencies": {
		"@baka/agent": "workspace:*",
		"@baka/engine": "workspace:*",
		"@baka/protocol": "workspace:*",
		"@baka/recipes": "workspace:*",
		"@baka/sdk": "workspace:*",
		"@baka/typescript-config": "workspace:*",
		"@baka/workflow-feature-planning": "workspace:*",
		"@baka/workflow-pack-management": "workspace:*",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "4.1.8",
		"tsup": "^8.3.5",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2",
		"vitest": "^4.1.8"
	}
}
