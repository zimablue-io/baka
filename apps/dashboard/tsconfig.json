{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["vite/client", "node"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts"]
}
