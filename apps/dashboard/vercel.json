{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "cd ../.. && pnpm run site",
	"outputDirectory": "dist/client",
	"ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../apps ../../packages ../../workflows ../../packs ../../scripts ../../turbo.json ../../tsconfig.json ../../install.sh ../../pnpm-lock.yaml ../../package.json ../../.nvmrc",
	"headers": [
		{
			"source": "/(install|install.sh)",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/plain; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=300"
				}
			]
		},
		{
			"source": "/releases/latest/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300"
				}
			]
		},
		{
			"source": "/releases/(v[^/]+)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
