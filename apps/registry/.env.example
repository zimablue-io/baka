# Registry server env vars (placeholder values — never commit real secrets).

# HTTP listener port (architecture §4.1; default 4300).
PORT=4300

# Public base URL (used for OAuth callbacks and absolute links).
BASE_URL=http://localhost:4300

# Directory the registry persists its data to. Relative paths resolve
# against cwd; absolute paths are used as-is.
DATA_DIR=.registry-data

# Subdirectory for artifact blobs (tarballs, previews).
STORAGE_DIR=artifacts

# Subdirectory for PGlite's data files.
PGLITE_DIR=pg

# PGlite socket port (used by the data layer feature; reserved here).
PGLITE_SOCKET_PORT=5444

# GitHub OAuth app credentials (architecture §4.4). Create the OAuth
# app at https://github.com/settings/developers with:
#   homepage URL:        http://localhost:4300
#   callback URL:        http://localhost:4300/api/auth/callback/github
# Place the resulting client id / secret below. NEVER commit real values.
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret

# Optional override for the session/cookie secret. If unset the
# registry derives a deterministic fallback from BASE_URL — fine for
# offline tests and local development, but production deployments MUST
# set this explicitly so sessions survive across restarts.
AUTH_SECRET=

# API-key rate limit overrides (Better-Auth's `apiKey` plugin). The
# plugin ships with a 10-request-per-24h-per-key default that trips
# concurrent validators and surprises self-hosters; the knobs below
# let operators raise the ceiling or disable the check entirely.
# Unset values keep the upstream default unchanged.
#
#   REGISTRY_API_KEY_RATE_LIMIT         "off" / "0" / "false" / "disabled"
#                                       disables the check; any other
#                                       value (or unset) leaves it on.
#   REGISTRY_API_KEY_RATE_LIMIT_MAX     positive integer; requests per
#                                       window. Default: 10.
#   REGISTRY_API_KEY_RATE_LIMIT_WINDOW_MS
#                                       positive integer (milliseconds);
#                                       the rolling window length.
#                                       Default: 86400000 (24h).
REGISTRY_API_KEY_RATE_LIMIT=
REGISTRY_API_KEY_RATE_LIMIT_MAX=
REGISTRY_API_KEY_RATE_LIMIT_WINDOW_MS=

# Official-org bootstrap (architecture §8 decisions 26 and 29).
#
#   REGISTRY_OFFICIAL_ORG      Slug of the official org. The registry
#                              creates the org at boot if absent, and
#                              bare-name publishing/resolution maps to
#                              this scope. Default: `baka`.
#
#   REGISTRY_OFFICIAL_PUBLISHERS
#                              Comma-separated list of identities
#                              authorized to publish to the official
#                              scope. Each entry is either a raw
#                              Better-Auth API key (any value that
#                              resolves to a user via the apiKey
#                              plugin) or a numeric GitHub user ID
#                              (matched against the `account.accountId`
#                              column for `providerId = 'github'`;
#                              entries that don't match an existing
#                              account are skipped). At boot the
#                              registry grants owner role on the
#                              official org to each resolved identity.
#                              Unset / empty means nobody can publish
#                              to the official scope (honest 403 at
#                              the publish route).
#
#                              Supported prefixes:
#                                `key:<value>`   force treat as API key
#                                `github:<value>` force treat as GitHub user ID
#
#                              Example:
#                                REGISTRY_OFFICIAL_PUBLISHERS=baka_abc...,github:123456
REGISTRY_OFFICIAL_ORG=baka
REGISTRY_OFFICIAL_PUBLISHERS=

# Stale-ingesting sweep threshold in milliseconds (VAL-PUB-028). The
# worker's per-cycle sweep resets rows stuck at `status='ingesting'`
# whose `updated_at` is older than this value back to `pending`. The
# default (`120_000`, the contract ceiling) converges a kill mid-ingest
# within the 120s poll ceiling; operators who need a tighter bound set
# this lower (e.g. `10000` for 10s). The BOOT sweep is unconditional
# and ignores this value — a freshly booted process owns no in-flight
# jobs, so every `ingesting` row at boot is recovered regardless of age.
REGISTRY_INGEST_STALE_MS=

# Per-recipe dry-run timeout in milliseconds (architecture §8 decision
# 6, VAL-SCAN-013). Each non-reasoning recipe runs in its own
# `node --permission` subprocess; this bound is the max wall time
# before the parent SIGKILLs the child and the version verdict
# becomes `unverified`. The default (`60_000`, 60s) is the documented
# ceiling; operators / tests tighten this to e.g. `500` for fast-fail
# unit-level timeout tests.
SCREEN_DRYRUN_TIMEOUT_MS=

# Verified-tier mechanism (architecture §8 decision 20). The
# registry's catalog supports a `verified` tier in addition to
# `official` / `community-screened` / `community-unverified`. The
# list of `verified` packs is server-attached and set via env so
# self-hosters can mark first-party or trusted community packs
# without a database migration.
#
#   REGISTRY_VERIFIED_PACKS
#       A JSON array of strings, each in `scope/name` form (e.g.
#       `"acme/internal-tools"`). The registry parses the env at
#       boot; invalid JSON logs a boot-time WARNING and degrades to
#       an empty verified list. Empty / unset means NO packs
#       carry the `verified` tier automatically (only ones the
#       operator hard-codes into the DB). The `official` scope
#       (REGISTRY_OFFICIAL_ORG) is ALWAYS `official`, never
#       `verified` — the two are distinct tiers.
#
#       Example:
#         REGISTRY_VERIFIED_PACKS=["acme/internal-tools","acme/lint-pack"]
#
#       The values are merged with any rows already in the DB
#       marked `tier='verified'` for that scope/name; an entry in
#       this list never demotes an `official` row.
REGISTRY_VERIFIED_PACKS=

# Test-only plumbing (architecture §8 decision 39, dry-run
# sandbox env scrubbing). When set, the registry forwards this
# JSON string to each dry-run subprocess as a `--canary-config`
# argv; the subprocess writes it to a file inside the recipe
# sandbox so the recipe body can read paths/values that must NOT
# leak through `process.env` (which is scrubbed for security).
# NEVER set this in production; tests in
# `apps/registry/test/dry-run.test.ts` and
# `apps/registry/test/output-validation.test.ts` are the only
# consumers. The env var key is reserved-by-the-tests.
BAKA_DRYRUN_TEST_CANARY_CONFIG=
