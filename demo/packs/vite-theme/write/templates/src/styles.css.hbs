:root {
	--accent: {{accent}};
	--bg: {{background}};
	--ink: {{ink}};
	--font: {{font}};
	--rule: color-mix(in srgb, var(--ink) 18%, transparent);
	--muted: color-mix(in srgb, var(--ink) 62%, var(--bg));
}

*,
*::before,
*::after {
	box-sizing: border-box;
}

html,
body {
	margin: 0;
	min-height: 100%;
	background: var(--bg);
}

#app {
	margin: 0 auto;
	max-width: 40rem;
	padding: 2.75rem 1.35rem 5rem;
	color: var(--ink);
	font-family: var(--font);
	font-size: 1.0625rem;
	line-height: 1.7;
}

header {
	padding-bottom: 1.6rem;
	margin-bottom: 2.4rem;
	border-bottom: 1px solid var(--rule);
}

header p {
	margin: 0.35rem 0 0;
	color: var(--muted);
	font-size: 0.78rem;
	letter-spacing: 0.16em;
	text-transform: uppercase;
}

nav {
	display: flex;
	flex-wrap: wrap;
	gap: 0.35rem 1.35rem;
	margin-top: 1.15rem;
}

nav a {
	color: var(--ink);
	text-decoration: none;
	font-size: 0.82rem;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	border-bottom: 1px solid transparent;
}

nav a:hover,
nav a:focus-visible {
	color: var(--accent);
	border-bottom-color: var(--accent);
}

.headline {
	margin: 0 0 1.6rem;
	font-size: 2.4rem;
	line-height: 1.12;
	letter-spacing: -0.04em;
	font-weight: 520;
}

p {
	margin: 0 0 1.15rem;
}

a {
	color: var(--accent);
}

footer {
	margin-top: 3.6rem;
	padding-top: 1.25rem;
	border-top: 1px solid var(--rule);
	color: var(--muted);
	font-size: 0.8rem;
	letter-spacing: 0.08em;
	text-transform: uppercase;
}
