{
	"name": "@baka/workspace",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"test": "turbo run test",
		"check-types": "turbo run check-types",
		"verify:core": "node scripts/verify-core-pack.mjs",
		"verify:cli": "node scripts/verify-cli-pack.mjs",
		"pack": "node scripts/pack-all.mjs",
		"knip": "node node_modules/knip/bin/knip.js --treat-config-hints-as-errors",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"clean": "find . -name 'dist' -type d -exec rm -rf {} +",
		"setup": "./scripts/setup.sh",
		"postinstall": "pnpm --filter @baka/cli run build",
		"baka": "node scripts/baka.mjs",
		"mcp": "pnpm --filter @baka/mcp dev",
		"link:global": "pnpm --filter @baka/cli --filter @baka/mcp exec pnpm link --global",
		"site": "pnpm build && node scripts/stage-site.mjs apps/dashboard/dist/client"
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/node": "^24.0.0",
		"knip": "5.88.1",
		"turbo": "^2.9.18",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=9.0.0"
	},
	"pnpm": {
		"overrides": {
			"handlebars": "4.7.10",
			"@modelcontextprotocol/sdk": "1.32.2",
			"hono": "4.13.18",
			"@hono/node-server": "1.19.19",
			"body-parser@2": "2.4.0",
			"undici@7": "7.30.2",
			"zod@4": "4.6.7",
			"esbuild@<0.28.1": "0.28.2",
			"ip-address@10": "10.7.6",
			"fast-uri@3": "3.1.9",
			"qs@6": "6.17.1",
			"postcss@8": "8.5.33",
			"nanoid@3": "3.3.20",
			"brace-expansion@5": "5.0.13",
			"smol-toml@1": "1.9.1",
			"source-map-js@1": "1.2.2",
			"proxy-addr@2": "2.0.8",
			"systeminformation@5": "5.33.23",
			"postcss-selector-parser@7": "7.2.1",
			"js-yaml@4": "4.3.2",
			"seroval": "1.6.12",
			"seroval-plugins": "1.6.12",
			"vite@8": "8.3.8",
			"vitest": "4.1.12",
			"@vitest/coverage-v8": "4.1.12"
		}
	}
}
