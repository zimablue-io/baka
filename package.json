{
	"name": "@baka/workspace",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"test": "turbo run test",
		"check-types": "turbo run check-types",
		"verify:core": "node scripts/verify-core-pack.mjs",
		"verify:cli": "node scripts/verify-cli-pack.mjs",
		"pack": "node scripts/pack-all.mjs",
		"knip": "node node_modules/knip/bin/knip.js --treat-config-hints-as-errors",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"clean": "find . -name 'dist' -type d -exec rm -rf {} +",
		"setup": "./scripts/setup.sh",
		"postinstall": "pnpm --filter @baka/cli run build",
		"baka": "node scripts/baka.mjs",
		"mcp": "pnpm --filter @baka/mcp dev",
		"link:global": "pnpm --filter @baka/cli --filter @baka/mcp exec pnpm link --global",
		"site": "pnpm build && node scripts/stage-site.mjs apps/dashboard/dist/client"
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/node": "^24.0.0",
		"knip": "5.88.1",
		"turbo": "^2.9.18",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=9.0.0"
	}
}
