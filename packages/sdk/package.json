{
	"name": "@baka/sdk",
	"version": "0.1.0",
	"description": "Public types and helpers for authoring baka packs. The only boundary pack authors import from.",
	"license": "Apache-2.0",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./package.json": "./package.json"
		},
		"type": "module"
	},
	"scripts": {
		"build": "tsup && node ../../scripts/rename-dts.mjs dist",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@baka/protocol": "workspace:*",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@baka/agent": "workspace:*",
		"@baka/typescript-config": "workspace:*",
		"@types/node": "^24.0.0",
		"tsup": "^8.3.5",
		"typescript": "^5.9.2",
		"vitest": "^4.1.8"
	}
}
