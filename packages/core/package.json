{
	"name": "@baka/core",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"description": "Embeddable Baka engine: run declared pack recipes deterministically, with an injected LLM provider for named slots only. No CLI, no process-global config.",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas/*": "./schemas/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"schemas",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"handlebars": "^4.7.8",
		"jiti": "^2.6.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@repo/ast-tooling": "workspace:*",
		"@repo/protocol": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^24.0.0",
		"tsup": "^8.3.5",
		"typescript": "^5.9.2",
		"vitest": "^4.1.8"
	}
}
