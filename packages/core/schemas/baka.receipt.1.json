{
	"$id": "https://baka.dev/schemas/baka.receipt/1",
	"title": "baka.receipt/1",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"schema": {
			"type": "string",
			"const": "baka.receipt/1"
		},
		"ok": {
			"type": "boolean"
		},
		"pack": {
			"type": "string"
		},
		"recipe": {
			"type": "string"
		},
		"params": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {}
		},
		"diagnostics": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"severity": {
						"type": "string",
						"enum": [
							"error",
							"warning"
						]
					},
					"rule": {
						"type": "string"
					},
					"message": {
						"type": "string"
					},
					"file": {
						"type": "string"
					},
					"hint": {
						"type": "string"
					},
					"validator": {
						"type": "string"
					},
					"pack": {
						"type": "string"
					}
				},
				"required": [
					"severity",
					"rule",
					"message"
				]
			}
		},
		"changeset": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string"
					},
					"op": {
						"type": "string",
						"enum": [
							"create",
							"update",
							"delete",
							"unchanged",
							"skip"
						]
					},
					"contentHash": {
						"type": [
							"string",
							"null"
						]
					},
					"reason": {
						"type": "string",
						"enum": [
							"identical",
							"already-exists"
						]
					},
					"mode": {
						"type": "string",
						"pattern": "^[0-7]{4}$"
					},
					"content": {
						"type": "string"
					}
				},
				"required": [
					"path",
					"op",
					"contentHash"
				]
			}
		},
		"outputTreeHash": {
			"type": "string"
		},
		"pins": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"version": {
						"type": "string"
					},
					"contentHash": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"version",
					"contentHash"
				]
			}
		},
		"slots": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"key": {
						"type": "string"
					},
					"match": {
						"type": "string",
						"enum": [
							"params",
							"template"
						]
					},
					"model": {
						"type": "string"
					},
					"value": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							{
								"type": "object",
								"propertyNames": {
									"type": "string"
								},
								"additionalProperties": {}
							}
						]
					},
					"source": {
						"type": "string",
						"enum": [
							"llm",
							"cache",
							"replay",
							"supplied"
						]
					}
				},
				"required": [
					"id",
					"key",
					"model",
					"value",
					"source"
				]
			}
		},
		"openSlots": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"kind": {
						"type": "string",
						"enum": [
							"prose",
							"ident",
							"list",
							"json"
						]
					},
					"hint": {
						"type": "string"
					},
					"file": {
						"type": "string",
						"minLength": 1
					},
					"max": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					},
					"item": {
						"type": "string"
					},
					"schemaPath": {
						"type": "string"
					},
					"templateKey": {
						"type": "string"
					}
				},
				"required": [
					"id",
					"kind",
					"hint",
					"file",
					"templateKey"
				]
			}
		},
		"compensation": {
			"type": "object",
			"properties": {
				"created": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"createdDirs": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"overwritten": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string"
							},
							"contentBase64": {
								"type": "string"
							},
							"mode": {
								"type": "string"
							}
						},
						"required": [
							"path",
							"contentBase64"
						]
					}
				},
				"recipeData": {}
			},
			"required": [
				"created",
				"createdDirs",
				"overwritten",
				"recipeData"
			]
		},
		"output": {},
		"dryRun": {
			"type": "boolean"
		}
	},
	"required": [
		"schema",
		"ok",
		"pack",
		"recipe",
		"params",
		"diagnostics",
		"changeset",
		"outputTreeHash",
		"pins",
		"slots",
		"compensation",
		"output",
		"dryRun"
	]
}
